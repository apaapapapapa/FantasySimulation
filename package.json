{
  "name": "fantasy-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test watch",
    "build": "vp run -r build",
    "db:migrate": "vp run --filter @fantasy/api db:migrate",
    "db:seed": "vp run --filter @fantasy/api db:seed",
    "verify": "vp check && vp run typecheck && vp test && vp run build"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
