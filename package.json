{
  "name": "fantasy-simulation",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apaapapapapa/FantasySimulation.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test watch",
    "build": "vp run -r build",
    "db:migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:seed": "vp run --filter @fantasy/api db:seed",
    "engine:stamp": "node scripts/engine-identity.ts --write",
    "engine:check": "node scripts/engine-identity.ts",
    "fixtures:tick": "node scripts/tick-fixtures.ts --write",
    "demo:tick": "node scripts/tick-demo.ts",
    "security:test": "node --test \"scripts/security/*.test.ts\"",
    "security:secrets": "node scripts/security/secrets.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "verify": "vp check && vp run typecheck && vp run engine:check && vp run check:quality && vp run security:test && vp test && vp run build",
    "bench:spatial": "node scripts/spatial-benchmark.ts",
    "fixtures:spatial": "node scripts/spatial-fixtures.ts --write",
    "harness": "node scripts/harness.ts",
    "check:quality": "node scripts/quality.ts",
    "demo:spatial": "node scripts/spatial-demo.ts",
    "catalog:spatial": "node scripts/spatial-catalog.ts",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:check": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs check"
  },
  "devDependencies": {
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "14.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.6",
    "better-sqlite3": "13.0.3",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "dependency-cruiser": "18.1.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
