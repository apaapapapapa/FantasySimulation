{
  "name": "fantasy-simulation",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apaapapapapa/FantasySimulation.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "test": "vp test",
    "test:watch": "vp test watch",
    "build": "vp run -r build",
    "db:migrate": "vp run --filter @fantasy/api db:migrate",
    "db:seed": "vp run --filter @fantasy/api db:seed",
    "engine:stamp": "node scripts/engine-identity.ts --write",
    "engine:check": "node scripts/engine-identity.ts",
    "fixtures:tick": "node scripts/tick-fixtures.ts --write",
    "demo:tick": "node scripts/tick-demo.ts",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "verify": "vp check && vp run typecheck && vp run engine:check && vp test && vp run build",
    "bench:spatial": "node scripts/spatial-benchmark.ts",
    "fixtures:spatial": "node scripts/spatial-fixtures.ts --write"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "24.13.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite-plus": "0.3.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.19.0"
}
