  "interpretation": [
    "63 timing artifacts, 187 unique process sidecars including all 60 compute partitions; ZIP SHA-256 values matched GitHub artifact metadata.",
    "Each match distribution is recomputed from all 7600 raw samples; p95 is nearest rank.",
    "Worker computeMs uses performance.now around stream.next. It includes record production and is elapsed time, not CPU.",
    "Worker thread CPU is part of process CPU. Do not add them. Inclusive spans overlap each other, including save/validate/decode/hash; they are not CPU or additive wall time.",
    "Match wall ends at replay commit/cleanup; later bundle publication and partition validation are outside that sample.",
    "Publish transport was killed before a sidecar was written. Its missing measurements are unknown, not zero. Pages acceptance is absent.",
    "Recovery uses existing immutable results and earlier R2 writes. Do not combine its duration with the original run into a fresh 7600-match acceptance.",
    "This baseline predates #210/#212/#213. It does not establish their improvement ratio or approve 16/32-runner production execution."
  ],
  "reproduction": {
    "source": "scripts/league-measurements.ts at baseline source SHA",
    "steps": [
      "List both pages of original run artifacts (186 total); select 63 league-timing artifacts including probe/prepare/60 compute/publish.",
      "Download each immutable artifact ID and require the listed ZIP SHA-256 before reading measurement-*.json; require matching source/run/attempt, 187 unique observation IDs, 60 cloud-run sidecars and 7600 unique simulation hashes.",
      "Run the existing league-measurements.ts summarizer on those measurement files; for each command sum process cpu.userMs+cpu.systemMs separately from inclusive span durations.",
      "Read actions.json from publish artifact; keep missing transport and Pages timestamps null. Read recovery artifact separately."
    ]
  }
