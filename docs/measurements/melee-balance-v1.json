    "driverSource": "import { readFileSync, writeFileSync, appendFileSync } from 'node:fs';\nimport { ManifestBuilder, leagueCoordinates, runPreparedBattle, reference } from '@fantasy/engine/spatial';\nconst [target, output, mode = 'pilot'] = process.argv.slice(2);\nconst league = JSON.parse(readFileSync('data/leagues/official-20-v2.json', 'utf8'));\nconst catalog = JSON.parse(readFileSync('data/spatial/catalog.json', 'utf8'));\nconst mapping = JSON.parse(readFileSync('.generated/balance/mapping.json', 'utf8'));\nconst oldBuilder = ManifestBuilder.from(league.revisions);\nconst newBuilder = ManifestBuilder.from(catalog);\nconst candidateRef = ref => mapping[ref.id]\n  ? reference(catalog.find(r => r.kind === 'character' && r.id === mapping[ref.id])) : ref;\nconst summary = { target, mode, cases: 0, before: {wins:0,draws:0,losses:0,invalid:0}, after: {wins:0,draws:0,losses:0,invalid:0}, rows: [] };\nwriteFileSync(output + '.jsonl', '');\nfunction measure(run, actor) {\n  const own = run.records.flatMap(r => r.events ?? []).filter(e => e.actorId === actor);\n  const outcome = run.result.outcome;\n  return { score: outcome.kind === 'win' ? outcome.winner === actor ? 'wins' : 'losses' : outcome.kind === 'draw' ? 'draws' : 'invalid',\n    result: run.result, hits: own.filter(e => e.kind === 'hit').length,\n    casts: own.filter(e => e.kind === 'cast-start').length,\n    damage: own.filter(e => e.kind === 'damage').reduce((s, e) => s + e.amount, 0),\n    emptyHits: own.filter(e => e.kind === 'damage' && e.amount === 0).length };\n}\nfor await (const {slot, spec} of leagueCoordinates(league)) {\n  if (!slot.characters.some(c => c.id === target) || slot.trial !== (mode === 'holdout' ? 1 : 0)) continue;\n  const opponent = slot.characters.find(c => c.id !== target).id;\n  if (mode === 'pilot' && (slot.scenario.id !== 'flat-surveyed-v1' || !['guardian','archer','fire-mage','stamina-scout-v1','water-observer'].includes(opponent))) continue;\n  const actor = spec.participants.find(p => p.character.id === target).actorId;\n  const updated = {...spec, participants: spec.participants.map(p => ({...p, character: candidateRef(p.character)}))};\n  const row = {opponent, scenario:slot.scenario.id, placement:slot.placement, trial:slot.trial, seed:slot.seed, actor};\n  for (const [label,builder,input] of [['before',oldBuilder,spec],['after',newBuilder,updated]]) {\n    row[label] = measure(await runPreparedBattle(await builder.build(input), league.budget), actor);\n    summary[label][row[label].score]++;\n  }\n  summary.cases++;\n  appendFileSync(output + '.jsonl', JSON.stringify(row) + '\\n');\n  summary.rows.push(row);\n  if (summary.cases % 20 === 0) console.log(target, summary.cases, summary.before, summary.after);\n}\nwriteFileSync(output + '.json', JSON.stringify(summary));\nconsole.log(JSON.stringify({...summary, rows: undefined}));\n",
    "commands": [
      "node .generated/balance/compare.mjs <old-character-id> <output-prefix> all",
      "node .generated/balance/compare.mjs <old-character-id> <output-prefix> holdout"
    ],
    "instructions": "Restore driverSource at .generated/balance/compare.mjs and mapping at .generated/balance/mapping.json; run from repository root with the pinned toolchain for each of the five old-character IDs. Driver uses the existing engine/league planner; no alternative simulator."
  }
}
